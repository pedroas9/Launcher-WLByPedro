
{
  "name": "minilogin-wl-by-pedroigeo",
  "version": "1.0.1",
  "description": "MiniLogin independiente creado por PedroIgeo.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "launcher",
    "minilogin"
  ],
  "author": "PedroIgeo",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pedroigeo.miniloginwl",
    "productName": "MiniLogin WL",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ],
    "win": {
      "icon": "recursos/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}


