{
  "name": "minilogin-wl-by-pedroigeo",
  "version": "0.1.4",
  "description": "MiniLogin independiente creado por PedroIgeo.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:publish": "electron-builder --win --publish always"
  },
  "keywords": [
    "electron",
    "launcher",
    "minilogin"
  ],
  "author": "PedroIgeo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pedroigeo.miniloginwl",
    "productName": "MiniLogin WL",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "pedroas9",
      "repo": "Launcher-WLByPedro",
      "releaseType": "release"
    },
    "asarUnpack": [
      "plugins/**"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ],
    "artifactName": "MiniLogin-WL-Setup-${version}.${ext}",
    "win": {
      "icon": "recursos/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}
